[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/main/options_ui.gd" id="1_script"]

[sub_resource type="LabelSettings" id="title_font"]
font_size = 28

[node name="OptionsUI" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -120.0
offset_right = 220.0
offset_bottom = 120.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
offset_left = 8.0
offset_top = 8.0
offset_right = 432.0
offset_bottom = 232.0

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "Options"
label_settings = SubResource("title_font")

[node name="ServerLabel" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "Server (ws://…)"

[node name="UrlEdit" type="LineEdit" parent="Panel/VBox"]
layout_mode = 2
placeholder_text = "ws://localhost:8765"

[node name="ConnectBtn" type="Button" parent="Panel/VBox"]
layout_mode = 2
text = "Kết nối"

[node name="Status" type="Label" parent="Panel/VBox"]
layout_mode = 2
text = "chưa kết nối"

[connection signal="pressed" from="Panel/VBox/ConnectBtn" to="." method="_on_connect_pressed"]
